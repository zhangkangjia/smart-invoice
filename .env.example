# ============================
# 智能开票平台环境变量配置
# 复制本文件为 .env 并修改
# ============================

# 基础设施密码（生产请修改）
POSTGRES_USER=smartinvoice
POSTGRES_PASSWORD=smartinvoice123
POSTGRES_DB=smart_invoice
POSTGRES_PORT=5432

RABBITMQ_USER=smartinvoice
RABBITMQ_PASSWORD=smartinvoice123

MINIO_ROOT_USER=smartinvoice
MINIO_ROOT_PASSWORD=smartinvoice123

# 端口
BACKEND_PORT=8000
FRONTEND_PORT=3000

# 应用
ENVIRONMENT=production
SECRET_KEY=请修改为随机长字符串

# 百望云（真实开票通道，不配则用模拟模式）
BAIWANG_APP_KEY=
BAIWANG_APP_SECRET=
BAIWANG_API_BASE_URL=https://open.baiwang.com
BAIWANG_ACCOUNT_ID=

# 企业微信（不配则跳过）
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=

# 微信服务号（不配则跳过）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
WECHAT_AES_KEY=

# 前端访问地址（用于通知中的跳转链接）
FRONTEND_BASE_URL=http://your-domain.com:3000
