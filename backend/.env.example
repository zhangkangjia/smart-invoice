# 智能开票平台后端环境变量配置

# 环境
ENVIRONMENT=development

# 安全
SECRET_KEY=dev-secret-key-change-in-production-please-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# 数据库
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_invoice
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/smart_invoice

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=smart-invoice
MINIO_SECURE=false

# CORS（逗号分隔）
CORS_ORIGINS=*

# 默认管理员
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123456
DEFAULT_ADMIN_EMAIL=admin@smart-invoice.local
